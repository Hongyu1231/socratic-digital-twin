# Mock identity signing (required for production builds; local development has a safe fallback)
DEMO_SESSION_SECRET=replace-with-a-long-random-value

# Optional Supabase persistence. If either value is absent, the app uses in-memory storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FORCE_MEMORY_REPOSITORY=false

# Server-only HMAC secret for stable, one-way evaluation pseudonyms. In local
# demos this can fall back to DEMO_SESSION_SECRET; use a distinct secret in production.
EXPERIMENT_PSEUDONYM_SECRET=

# Lock exactly one Tutor implementation for the POC: deterministic, openai, or claude.
TUTOR_PROVIDER=deterministic

# Required only when TUTOR_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROXY_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Required only when TUTOR_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
